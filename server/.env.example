PORT=4000
DATABASE_URL=postgres://nossteal:nossteal@localhost:5432/nossteal_mail
JWT_SECRET=change-me-to-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=change-me-32-byte-base64-or-hex-key

# Inbound SMTP receiver port. 2525 for local dev; 25 on a public server.
MAIL_SMTP_PORT=2525

# Optional: domain that new signups get a mailbox on (username@MAIL_DOMAIN).
# A matching domains row must exist (add it on the Domains page). Leave unset
# to require users to register with their own external email instead.
# MAIL_DOMAIN=example.com

# Registration mode: "open" (default, anyone can sign up) or "invite"
# (a valid single-use invite code is required; admins generate them).
# REGISTRATION_MODE=open

# Secret token embedded in the inbound-email webhook URL
# (POST /api/inbound/<secret>). Point a mail service's inbound route/parse at
# that URL (via a public tunnel) to receive external mail without port 25.
# INBOUND_WEBHOOK_SECRET=change-me-to-a-long-random-string
